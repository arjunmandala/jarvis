# Linear (from the OAuth app you register). CLIENT_ID/SECRET drive automatic
# client_credentials token renewal; the live token lives in SQLite (oauth_tokens),
# not here. LINEAR_ACCESS_TOKEN is optional — a bootstrap seed only, used once
# before the first renewal persists a real token. Leave blank to bootstrap via /oauth/callback.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_ACCESS_TOKEN=
# Anthropic / E2B / GitHub
ANTHROPIC_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE=jarvis-agent
GH_TOKEN=
# Target repo for the slice, "owner/name"
TARGET_REPO=
# Public URL of this service (for the OAuth redirect + Linear webhook), e.g. https://jarvis.example.com
PUBLIC_BASE_URL=
PORT=3000
